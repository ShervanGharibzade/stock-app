# Copy this file to `.env.local` and fill in your own Polygon.io API key.
# NOTE: NEXT_PUBLIC_* variables are bundled into the browser build, so use a
# free/restricted key and never reuse a key that protects anything valuable.
NEXT_PUBLIC_APP_API_KEY=your_polygon_api_key
NEXT_PUBLIC_APP_BASE_URL=https://api.polygon.io/v1/indicators/sma
